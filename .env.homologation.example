NODE_ENV=production
API_PORT=3333
DATABASE_URL=postgresql://evolua_homologacao:troque-esta-senha@localhost:5432/evolua_core_homologacao
SESSION_DAYS=30
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://evolua_homologacao:troque-esta-senha@localhost:5672
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=evolua_homologacao
S3_SECRET_KEY=troque-esta-senha
S3_BUCKET=evolua-media-homologacao

# URL acessível pelo aparelho físico na mesma rede local.
# Copie este arquivo para .env.homologation e ajuste o IP antes do build.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3333/v1

# IA local opcional. Se vazio, o assistente usa o fallback determinístico/local.
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=
