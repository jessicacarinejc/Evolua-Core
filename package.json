{
  "name": "evolua-core",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @evolua/mobile run start",
    "android": "npm --workspace @evolua/mobile run android",
    "ios": "npm --workspace @evolua/mobile run ios",
    "api:dev": "npm --workspace @evolua/api run start:dev",
    "api:build": "npm --workspace @evolua/api run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "homologacao:infra": "docker compose --env-file .env.homologation -f docker-compose.homologation.yml up -d",
    "homologacao:migrate": "node --env-file=.env.homologation scripts/apply-local-migrations.mjs",
    "homologacao:api": "node --env-file=.env.homologation scripts/start-local-homologation-api.mjs",
    "homologacao:android": "node --env-file=.env.homologation scripts/build-android-homologation.mjs",
    "homologacao:ios": "node --env-file=.env.homologation scripts/build-ios-homologation.mjs",
    "homologacao:portal": "node --env-file=.env.homologation scripts/serve-professional-portal.mjs",
    "homologacao:admin": "node --env-file=.env.homologation scripts/promote-local-admin.mjs",
    "homologacao:smoke": "node --env-file=.env.homologation scripts/smoke-local-homologation.mjs",
    "homologacao:e2e": "node --env-file=.env.homologation scripts/e2e-local-homologation.mjs",
    "homologacao:media": "node scripts/audit-local-media.mjs"
  },
  "engines": {
    "node": ">=20.19"
  }
}
