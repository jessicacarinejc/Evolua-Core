{
  "expo": {
    "name": "Evolua Core",
    "slug": "evolua-core",
    "version": "0.1.5",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.evoluacore.app",
      "buildNumber": "6",
      "icon": "./assets/brand/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.evoluacore.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "brandName": "Evolua Core",
      "tagline": "Treino. Nutrição. Saúde. Evolução.",
      "releaseChannel": "homologacao-mobile-offline",
      "offlineHomologation": true
    }
  }
}