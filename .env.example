NODE_ENV=development
API_PORT=3333
DATABASE_URL=postgresql://evolua:evolua@localhost:5432/evolua_core
SESSION_DAYS=30
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://evolua:evolua@localhost:5672
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=evolua
S3_SECRET_KEY=change-me
S3_BUCKET=evolua-media

# IA local opcional para o Evolua Assist (ex.: Ollama na própria máquina)
# Se omitido, o assistente usa fallback local baseado em regras e contexto.
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=
